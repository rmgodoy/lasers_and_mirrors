<div class="lasers-and-mirrors-sheet">
  <h2>{{#if isGM}}{{localize "LAM.sheets.mirror.title"}}{{else}}{{localize "LAM.sheets.mirrorPlayer.title"}}{{/if}}</h2>

  {{#if isGM}}
  <div class="form-group">
    <label for="color">{{localize "LAM.labels.color"}}</label>
    <input type="color" name="color" value="{{color}}"/>
  </div>

  <div class="form-group">
    <label for="width">{{localize "LAM.labels.width"}}</label>
    <input type="number" name="width" min="0.5" max="5" step="0.5" value="{{width}}"/>
  </div>

  <div class="form-group">
    <label for="twoSided">{{localize "LAM.labels.twoSided"}}</label>
    <input type="checkbox" name="twoSided" {{checked twoSided}}/>
  </div>

  <div class="form-group">
    <label for="interactable">{{localize "LAM.labels.interactable"}}</label>
    <input type="checkbox" name="interactable" {{checked interactable}}/>
  </div>

  <div class="form-group">
    <label for="attachable">{{localize "LAM.labels.attachable"}}</label>
    <input type="checkbox" name="attachable" {{checked attachable}}/>
  </div>

  <div class="form-group">
    <label for="limitRotation">{{localize "LAM.labels.limitRotation"}}</label>
    <input type="checkbox" name="limitRotation" {{checked limitRotation}}/>
  </div>

  <div class="lam-limits-container">
    <div class="form-group">
      <label for="minDeg">{{localize "LAM.labels.minDeg"}}</label>
      <div class="lam-input-with-button">
        <input type="number" name="minDeg" min="0" max="360" step="0.1" value="{{minDeg}}"/>
        <button type="button" class="lam-btn-action" data-action="setCurrentMin" title="{{localize 'LAM.buttons.setCurrentMin'}}">
          <i class="fas fa-arrow-down"></i> {{localize "LAM.buttons.setCurrentMinShort"}}
        </button>
      </div>
    </div>

    <div class="form-group">
      <label for="maxDeg">{{localize "LAM.labels.maxDeg"}}</label>
      <div class="lam-input-with-button">
        <input type="number" name="maxDeg" min="0" max="360" step="0.1" value="{{maxDeg}}"/>
        <button type="button" class="lam-btn-action" data-action="setCurrentMax" title="{{localize 'LAM.buttons.setCurrentMax'}}">
          <i class="fas fa-arrow-up"></i> {{localize "LAM.buttons.setCurrentMaxShort"}}
        </button>
      </div>
    </div>

    <div class="form-group lam-flip-row">
      <button type="button" class="lam-btn-flip" data-action="flipLimits" title="{{localize 'LAM.buttons.flipLimitsHint'}}">
        <i class="fas fa-arrows-rotate"></i> {{localize "LAM.buttons.flipLimits"}}
      </button>
      <span class="lam-arc-summary">{{arcSummary}}</span>
    </div>
  </div>
  {{/if}}

  <div class="form-group">
    <label for="orientation">{{localize "LAM.labels.orientation"}}</label>
    <input type="range" name="orientation" min="0" max="360" step="0.1" value="{{orientation}}"/>
    <span class="range-value">{{orientation}}°</span>
  </div>
</div>
