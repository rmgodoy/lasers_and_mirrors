<div class="lam-behavior-form">
  <div class="lam-macro-help">
    <p><i class="fas fa-info-circle"></i> {{localize "LAM.behaviors.macro.contextHelp"}}</p>
    <code>token, actor, beamData, variables, event, scene, context</code>
