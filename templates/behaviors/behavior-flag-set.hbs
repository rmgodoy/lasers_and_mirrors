<div class="lam-behavior-form">
  <div class="form-group">
    <label for="flagScope">{{localize "LAM.behaviors.setFlag.scope"}}</label>
    <input type="text" name="flagScope" value="{{config.flagScope}}" placeholder="world"/>
  </div>

  <div class="form-group">
    <label for="flagName">{{localize "LAM.behaviors.setFlag.flagName"}}</label>
    <input type="text" name="flagName" value="{{config.flagName}}" placeholder="e.g. puzzleSolved" required/>
  </div>

  <div class="form-group">
    <label for="value">{{localize "LAM.behaviors.setFlag.value"}}</label>
    <input type="text" name="value" value="{{config.value}}" placeholder="e.g. true, 10, 'secret', $myVar"/>
  </div>
</div>
