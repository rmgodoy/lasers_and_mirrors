<div class="lasers-and-mirrors-sheet lam-behavior-editor-dialog">
  <div class="form-group lam-type-header">
    <label for="type"><i class="fas fa-shapes"></i> {{localize "LAM.behaviors.editor.type"}}</label>
    <select name="type" class="lam-behavior-type-select">
      {{#each typeOptions}}
      <option value="{{this.type}}" {{#if this.selected}}selected{{/if}}>
        {{localize this.label}}
      </option>
      {{/each}}
    </select>
  </div>

  <div class="form-group">
    <label for="enabled">{{localize "LAM.behaviors.common.enabled"}}</label>
    <input type="checkbox" name="enabled" {{#if config.enabled}}checked{{/if}}/>
  </div>

  <hr/>

  <div class="lam-behavior-body">
    {{#if isLight}}
      {{> "modules/LasersAndMirrors/templates/behaviors/behavior-light.hbs"}}
    {{else if isDoor}}
      {{> "modules/LasersAndMirrors/templates/behaviors/behavior-door.hbs"}}
    {{else if isTile}}
      {{> "modules/LasersAndMirrors/templates/behaviors/behavior-tile.hbs"}}
    {{else if isMacro}}
      {{> "modules/LasersAndMirrors/templates/behaviors/behavior-macro.hbs"}}
    {{else if isReadFlag}}
      {{> "modules/LasersAndMirrors/templates/behaviors/behavior-flag-read.hbs"}}
    {{else if isSetFlag}}
      {{> "modules/LasersAndMirrors/templates/behaviors/behavior-flag-set.hbs"}}
    {{else if isSetVariable}}
      {{> "modules/LasersAndMirrors/templates/behaviors/behavior-set-variable.hbs"}}
    {{else if isReadTrigger}}
      {{> "modules/LasersAndMirrors/templates/behaviors/behavior-trigger-read.hbs"}}
    {{else if isConditional}}
      {{> "modules/LasersAndMirrors/templates/behaviors/behavior-conditional.hbs"}}
    {{/if}}
  </div>

  <div class="lam-dialog-footer">
    <button type="button" class="lam-btn-secondary" data-action="cancel">
      <i class="fas fa-times"></i> {{localize "Cancel"}}
    </button>
    <button type="submit" class="lam-btn-primary" data-action="save">
      <i class="fas fa-check"></i> {{localize "Save"}}
    </button>
  </div>
</div>
